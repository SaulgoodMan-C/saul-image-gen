[defaults]
DEFAULT_QUALITY=
DEFAULT_ASPECT_RATIO=
DEFAULT_OUTPUT_DIR=~/Desktop/images

[image-api]
# Supports Tuzi, official OpenAI image APIs, OpenAI-compatible relays,
# and providers compatible with /responses or /images/generations.
IMAGE_API_KEY=your_key_here
IMAGE_API_URL=https://api.tu-zi.com/coding
IMAGE_MODEL=gpt-image-2
IMAGE_WIRE_API=responses
IMAGE_REF_MODE=generations-json

# Optional endpoint overrides for non-standard relays.
# IMAGE_RESPONSES_URL=https://api.example.com/custom/responses
# IMAGE_GENERATIONS_URL=https://api.example.com/custom/image
# IMAGE_EDITS_URL=https://api.example.com/custom/image-edits
